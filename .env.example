# Copiar este archivo como .env y completar los valores

# Groq LLM
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Neo4j (sobreescribe los valores del docker-compose si se define aquí)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=cambiar-por-un-secreto-largo
NEO4J_DATABASE=neo4j

# Token requerido para operaciones administrativas
ADMIN_TOKEN=cambiar-por-otro-secreto-largo
